# Copy to .env.local and adjust as needed. Never commit real secrets.

# Public base URL of the app, used by the server to call its own route
# handlers (e.g. /health -> /api/health). Optional: defaults to
# https://$VERCEL_URL on Vercel, otherwise http://localhost:$PORT (3000).
APP_URL=

# Google Gemini API key for the /assistant chat (server-side only; never
# prefix it with NEXT_PUBLIC_). Create one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
