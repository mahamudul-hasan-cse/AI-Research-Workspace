# Copy to .env.local and adjust as needed. Never commit real secrets.

# Public base URL of the app, used by the server to call its own route
# handlers (e.g. /health -> /api/health). Optional: on Vercel production it
# defaults to the project's production domain, on previews to $VERCEL_URL,
# otherwise http://localhost:$PORT (3000). Do not point it at a protected
# per-deployment *.vercel.app URL.
APP_URL=

# OpenRouter API key for the /assistant chat (server-side only; never prefix
# it with NEXT_PUBLIC_). Create one at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Local test builds only. Leave at 0 (or unset) for normal production builds.
# Playwright sets this to 1 itself; Vercel rejects builds with it enabled.
NEXT_PUBLIC_ENABLE_CHAT_SABOTAGE=0

# Vercel supplies VERCEL, VERCEL_ENV, VERCEL_URL and
# VERCEL_PROJECT_PRODUCTION_URL automatically. Do not copy them locally.
# Protected previews may use VERCEL_AUTOMATION_BYPASS_SECRET, configured in
# Vercel's Protection Bypass for Automation settings (server-side secret).

# Optional local server port: PORT (defaults to 3000).
# NODE_ENV is set by Next.js/test runners; CI is supplied by GitHub Actions.
